{
  "listen": "0.0.0.0",
  "port": 8080,
  "allowed_hosts": ["192.0.2.10", "127.0.0.1", "localhost"],
  "poll_seconds": 60,
  "alert_after_seconds": 120,
  "recovery_after_seconds": 60,
  "notify_retry_seconds": 900,
  "worker_stale_seconds": 600,
  "queue_age_seconds": 900,
  "api_interval_seconds": 900,
  "backup_age_seconds": 604800,
